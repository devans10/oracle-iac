# Secrets — NEVER commit
*.vault
*.vault.yml
**/vault.yml
.vault_pass
*.p12
*.jks
*.pem
*.key
*.pfx
*.crt
*.cer
*.der
secrets/
.env
.env.*
.ps_credentials

# Terraform state — contains secrets
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl
*.tfvars
!*.tfvars.example

# Ansible generated/sensitive
ansible/inventories/*.retry
ansible/inventories/primary.yml
ansible/inventories/dr.yml
ansible/inventories/dev.yml
# vault.yml covered by **/vault.yml above (ansible/group_vars, host_vars, etc.)
ansible/group_vars/**/vault.yml
host_vars/**/vault.yml
ansible/host_vars/**/vault.yml

# Oracle software media and installers
*.zip
*.jar
*.tar.gz
*.gz
*.properties
media/

# Logs and temp
*.log
tmp/
.tmp/
*.tmp

# IDE
.idea/
.vscode/
*.swp
*.swo
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db
