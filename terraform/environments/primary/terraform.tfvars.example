# terraform.tfvars.example — copy to terraform.tfvars and fill in values
# terraform.tfvars is .gitignored — NEVER commit

libvirt_uri_ccb_a = "qemu+ssh://root@kvm-host-ccb-a.company.internal/system"
libvirt_uri_ccb_b = "qemu+ssh://root@kvm-host-ccb-b.company.internal/system"
libvirt_uri_mdm_a = "qemu+ssh://root@kvm-host-mdm-a.company.internal/system"
libvirt_uri_mdm_b = "qemu+ssh://root@kvm-host-mdm-b.company.internal/system"
libvirt_uri_soa_a = "qemu+ssh://root@kvm-host-soa-a.company.internal/system"
libvirt_uri_soa_b = "qemu+ssh://root@kvm-host-soa-b.company.internal/system"
libvirt_uri_web   = "qemu+ssh://root@kvm-host-web.company.internal/system"

oracle_linux_image = "/var/lib/libvirt/images/OracleLinux-9-base.qcow2"
app_network        = "oracle-app-net"
ssh_pubkey         = "ssh-rsa AAAA... your-key-here"
