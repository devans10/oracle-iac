# terraform.tfvars.example — copy to terraform.tfvars and fill in values
# terraform.tfvars is .gitignored — NEVER commit

libvirt_uri        = "qemu+ssh://root@kvm-host-dev.company.internal/system"
oracle_linux_image = "/var/lib/libvirt/images/OracleLinux-9-base.qcow2"
app_network        = "oracle-dev-net"
ssh_pubkey         = "ssh-rsa AAAA... your-key-here"
