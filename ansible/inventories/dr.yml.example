---
# dr.yml.example — copy to dr.yml and fill in real hostnames/IPs for DR Site B
# dr.yml is .gitignored — NEVER commit real inventory values
#
# Structure mirrors primary.yml.example exactly.
# All host names carry a -dr- infix and use 10.2.x.x (DR site subnet).
# This inventory is used with activate-dr.sh and for post-failover app restarts:
#   ansible-playbook ansible/playbooks/site/site.yml -i ansible/inventories/dr.yml --tags configure

all:
  vars:
    ansible_user: oracle
    ansible_ssh_private_key_file: ~/.ssh/oracle_iac_ed25519
    env: dr
    oracle_base: /u01/oracle
    oracle_products: /u01/oracle/products
    oracle_config: /u01/oracle/config
    oracle_logs: /u01/oracle/logs

    # Oracle stage/media paths
    oracle_stage:    /u01/oracle/stage
    media_base_path: /u01/oracle/media

    # Feature flags — match primary production defaults
    enable_ohs:        true
    enable_saml:       true
    enable_nfs:        true
    enable_monitoring: true

    # Data Guard settings — DR site is the standby
    enable_data_guard: true
    dg_role: standby

    # DR site SCAN listeners — override all/main.yml production RAC addresses.
    # oracle-rac-client uses these for tnsnames.ora generation.
    ccb_db_scan: "dr-ccb-scan.company.internal"
    mdm_db_scan: "dr-mdm-scan.company.internal"
    soa_db_scan: "dr-soa-scan.company.internal"

  children:
    ohs_servers:
      hosts:
        ohs-dr-vm-01.company.internal:
          ansible_host: 10.2.10.11
        ohs-dr-vm-02.company.internal:
          ansible_host: 10.2.10.12
        ohs-dr-vm-03.company.internal:
          ansible_host: 10.2.10.13

    ccb_admin:
      hosts:
        ccb-admin-dr-vm-01.company.internal:
          ansible_host: 10.2.20.10
      vars:
        wls_domain: ccb_domain
        wls_admin_port: 7001

    ccb_web:
      hosts:
        ccb-web-dr-vm-01.company.internal:
          ansible_host: 10.2.20.11
          wls_ms_name: CCB-WEB-MS-01
          wls_ms_port: 7002
        ccb-web-dr-vm-02.company.internal:
          ansible_host: 10.2.20.12
          wls_ms_name: CCB-WEB-MS-02
          wls_ms_port: 7002
        ccb-web-dr-vm-03.company.internal:
          ansible_host: 10.2.20.13
          wls_ms_name: CCB-WEB-MS-03
          wls_ms_port: 7002
        ccb-web-dr-vm-04.company.internal:
          ansible_host: 10.2.20.14
          wls_ms_name: CCB-WEB-MS-04
          wls_ms_port: 7002
      vars:
        wls_cluster: CCB-WEB
        wls_domain: ccb_domain

    ccb_iws:
      hosts:
        ccb-iws-dr-vm-01.company.internal:
          ansible_host: 10.2.20.21
          wls_ms_name: CCB-IWS-MS-01
          wls_ms_port: 7004
        ccb-iws-dr-vm-02.company.internal:
          ansible_host: 10.2.20.22
          wls_ms_name: CCB-IWS-MS-02
          wls_ms_port: 7004
        ccb-iws-dr-vm-03.company.internal:
          ansible_host: 10.2.20.23
          wls_ms_name: CCB-IWS-MS-03
          wls_ms_port: 7004
        ccb-iws-dr-vm-04.company.internal:
          ansible_host: 10.2.20.24
          wls_ms_name: CCB-IWS-MS-04
          wls_ms_port: 7004
      vars:
        wls_cluster: CCB-IWS
        wls_domain: ccb_domain

    ccb_batch:
      hosts:
        ccb-batch-dr-vm-01.company.internal:
          ansible_host: 10.2.20.31
          wls_ms_name: CCB-BATCH-MS-01
          wls_ms_port: 7006
        ccb-batch-dr-vm-02.company.internal:
          ansible_host: 10.2.20.32
          wls_ms_name: CCB-BATCH-MS-02
          wls_ms_port: 7006
