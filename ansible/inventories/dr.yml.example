              wls_ms_port: 8003
            osb-integ-dr-vm-02.company.internal:
              ansible_host: 10.2.40.12
              wls_ms_name: INTEG_OsbServer2
              wls_ms_port: 8003
        soa_integ_soa:
          hosts:
            soa-integ-dr-vm-01.company.internal:
              ansible_host: 10.2.40.13
              wls_ms_name: INTEG_SoaServer1
              wls_ms_port: 8005
            soa-integ-dr-vm-02.company.internal:
