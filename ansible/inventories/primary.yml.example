---
# primary.yml.example — copy to primary.yml and fill in real hostnames/IPs
# primary.yml is .gitignored — NEVER commit real inventory values

all:
  vars:
    ansible_user: oracle
    ansible_ssh_private_key_file: ~/.ssh/oracle_iac_rsa
    env: primary
    oracle_base: /u01/oracle
    oracle_products: /u01/oracle/products
    oracle_config: /u01/oracle/config
    oracle_logs: /u01/oracle/logs

    # Oracle stage/media paths (also in group_vars/all but inventory can override)
    oracle_stage:    /u01/oracle/stage
    media_base_path: /u01/oracle/media

    # Feature flags (production defaults; override to false in dev inventory)
    enable_ohs:        true
    enable_saml:       true
    enable_nfs:        true
    enable_monitoring: true

  children:
    ohs_servers:
      hosts:
        ohs-vm-01.company.internal:
        ohs-vm-02.company.internal:
        ohs-vm-03.company.internal:

    ccb_admin:
      hosts:
        ccb-admin-vm-01.company.internal:
      vars:
        wls_domain: ccb_domain
        wls_admin_port: 7001

    ccb_web:
      hosts:
        ccb-web-vm-01.company.internal:
          wls_ms_name: CCB-WEB-MS-01
          wls_ms_port: 7002
        ccb-web-vm-02.company.internal:
          wls_ms_name: CCB-WEB-MS-02
          wls_ms_port: 7002
        ccb-web-vm-03.company.internal:
          wls_ms_name: CCB-WEB-MS-03
          wls_ms_port: 7002
        ccb-web-vm-04.company.internal:
          wls_ms_name: CCB-WEB-MS-04
          wls_ms_port: 7002
      vars:
        wls_cluster: CCB-WEB
        wls_domain: ccb_domain

    ccb_iws:
      hosts:
        ccb-iws-vm-01.company.internal:
          wls_ms_name: CCB-IWS-MS-01
          wls_ms_port: 7004
        ccb-iws-vm-02.company.internal:
          wls_ms_name: CCB-IWS-MS-02
          wls_ms_port: 7004
        ccb-iws-vm-03.company.internal:
          wls_ms_name: CCB-IWS-MS-03
          wls_ms_port: 7004
        ccb-iws-vm-04.company.internal:
          wls_ms_name: CCB-IWS-MS-04
          wls_ms_port: 7004
      vars:
        wls_cluster: CCB-IWS
        wls_domain: ccb_domain

    ccb_batch:
      hosts:
        ccb-batch-vm-01.company.internal:
          wls_ms_name: CCB-BATCH-MS-01
          wls_ms_port: 7006
        ccb-batch-vm-02.company.internal:
          wls_ms_name: CCB-BATCH-MS-02
          wls_ms_port: 7006
      vars:
        wls_cluster: CCB-BATCH
        wls_domain: ccb_domain

    mdm_admin:
      hosts:
        mdm-admin-vm-01.company.internal:
      vars:
        wls_domain: mdm_domain
        wls_admin_port: 7011

    mdm_web:
      hosts:
        mdm-web-vm-01.company.internal:
          wls_ms_name: MDM-WEB-MS-01
          wls_ms_port: 7012
        mdm-web-vm-02.company.internal:
          wls_ms_name: MDM-WEB-MS-02
          wls_ms_port: 7012
      vars:
        wls_cluster: MDM-WEB
        wls_domain: mdm_domain

    mdm_iws:
      hosts:
        mdm-iws-vm-01.company.internal:
          wls_ms_name: MDM-IWS-MS-01
          wls_ms_port: 7014
        mdm-iws-vm-02.company.internal:
          wls_ms_name: MDM-IWS-MS-02
          wls_ms_port: 7014
        mdm-iws-vm-03.company.internal:
          wls_ms_name: MDM-IWS-MS-03
          wls_ms_port: 7014
        mdm-iws-vm-04.company.internal:
          wls_ms_name: MDM-IWS-MS-04
          wls_ms_port: 7014
      vars:
        wls_cluster: MDM-IWS
        wls_domain: mdm_domain

    mdm_batch:
      hosts:
        mdm-batch-vm-01.company.internal:
          wls_ms_name: MDM-BATCH-MS-01
          wls_ms_port: 7016
        mdm-batch-vm-02.company.internal:
          wls_ms_name: MDM-BATCH-MS-02
          wls_ms_port: 7016
      vars:
        wls_cluster: MDM-BATCH
        wls_domain: mdm_domain

    soa_integ:
      vars:
        wls_domain: soa_integ
        wls_admin_port: 8001
        soainfra_schema_prefix: INTEG
      children:
        soa_integ_adm:
          hosts:
            adm-integ-vm-01.company.internal:
              ansible_host: 10.0.40.10
        soa_integ_osb:
          hosts:
            osb-integ-vm-01.company.internal:
              ansible_host: 10.0.40.11
              wls_ms_name: INTEG_OsbServer1
              wls_ms_port: 8003
            osb-integ-vm-02.company.internal:
              ansible_host: 10.0.40.12
              wls_ms_name: INTEG_OsbServer2
              wls_ms_port: 8003
        soa_integ_soa:
          hosts:
            soa-integ-vm-01.company.internal:
              ansible_host: 10.0.40.13
              wls_ms_name: INTEG_SoaServer1
              wls_ms_port: 8005
            soa-integ-vm-02.company.internal:
              ansible_host: 10.0.40.14
              wls_ms_name: INTEG_SoaServer2
              wls_ms_port: 8005
        soa_integ_wsm:
