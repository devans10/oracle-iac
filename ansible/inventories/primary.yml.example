            wsm-integ-vm-01.company.internal:
              ansible_host: 10.0.40.15
              wls_ms_name: INTEG_WsmServer1
              wls_ms_port: 8007

    soa_intf:
      vars:
        wls_domain: soa_intf
        wls_admin_port: 8021
        soainfra_schema_prefix: INTF
      children:
        soa_intf_adm:
          hosts:
            adm-intf-vm-01.company.internal:
              ansible_host: 10.0.41.10
        soa_intf_osb:
          hosts:
            osb-intf-vm-01.company.internal:
              ansible_host: 10.0.41.11
              wls_ms_name: INTF_OsbServer1
              wls_ms_port: 8023
            osb-intf-vm-02.company.internal:
              ansible_host: 10.0.41.12
              wls_ms_name: INTF_OsbServer2
              wls_ms_port: 8023
        soa_intf_soa:
          hosts:
            soa-intf-vm-01.company.internal:
              ansible_host: 10.0.41.13
              wls_ms_name: INTF_SoaServer1
              wls_ms_port: 8025
            soa-intf-vm-02.company.internal:
              ansible_host: 10.0.41.14
              wls_ms_name: INTF_SoaServer2
              wls_ms_port: 8025
        soa_intf_bam:
          hosts:
            bam-intf-vm-01.company.internal:
              ansible_host: 10.0.41.15
              wls_ms_name: INTF_BamServer1
              wls_ms_port: 8027
        soa_intf_odi:
          hosts:
            odi-intf-vm-01.company.internal:
              ansible_host: 10.0.41.16
              wls_ms_name: INTF_OdiServer1
              wls_ms_port: 8029
            odi-intf-vm-02.company.internal:
              ansible_host: 10.0.41.17
              wls_ms_name: INTF_OdiServer2
              wls_ms_port: 8029
        soa_intf_wsm:
          hosts:
            wsm-intf-vm-01.company.internal:
              ansible_host: 10.0.41.18
              wls_ms_name: INTF_WsmServer1
              wls_ms_port: 8031

    soa_web:
      vars:
        wls_domain: soa_web
        wls_admin_port: 8041
        soainfra_schema_prefix: WEB
      children:
        soa_web_adm:
          hosts:
            adm-web-vm-01.company.internal:
              ansible_host: 10.0.42.10
        soa_web_osb:
          hosts:
            osb-web-vm-01.company.internal:
              ansible_host: 10.0.42.11
              wls_ms_name: WEB_OsbServer1
              wls_ms_port: 8043
            osb-web-vm-02.company.internal:
              ansible_host: 10.0.42.12
              wls_ms_name: WEB_OsbServer2
              wls_ms_port: 8043
            osb-web-vm-03.company.internal:
              ansible_host: 10.0.42.13
              wls_ms_name: WEB_OsbServer3
              wls_ms_port: 8043
            osb-web-vm-04.company.internal:
              ansible_host: 10.0.42.14
              wls_ms_name: WEB_OsbServer4
              wls_ms_port: 8043
        soa_web_soa:
          hosts:
            soa-web-vm-01.company.internal:
              ansible_host: 10.0.42.15
              wls_ms_name: WEB_SoaServer1
              wls_ms_port: 8045
            soa-web-vm-02.company.internal:
              ansible_host: 10.0.42.16
              wls_ms_name: WEB_SoaServer2
              wls_ms_port: 8045
            soa-web-vm-03.company.internal:
              ansible_host: 10.0.42.17
              wls_ms_name: WEB_SoaServer3
              wls_ms_port: 8045
            soa-web-vm-04.company.internal:
              ansible_host: 10.0.42.18
              wls_ms_name: WEB_SoaServer4
              wls_ms_port: 8045
        soa_web_bam:
          hosts:
            bam-web-vm-01.company.internal:
              ansible_host: 10.0.42.19
              wls_ms_name: WEB_BamServer1
              wls_ms_port: 8047
        soa_web_wsm:
          hosts:
            wsm-web-vm-01.company.internal:
              ansible_host: 10.0.42.20
              wls_ms_name: WEB_WsmServer1
              wls_ms_port: 8049

    soa_sgg:
      vars:
        wls_domain: soa_sgg
        wls_admin_port: 8061
        soainfra_schema_prefix: SGG
      children:
        soa_sgg_adm:
