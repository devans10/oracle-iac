            soa-sgg-vm-02.company.internal:
              ansible_host: 10.0.43.18
              wls_ms_name: SGG_SoaServer2
              wls_ms_port: 8065
            soa-sgg-vm-03.company.internal:
              ansible_host: 10.0.43.19
              wls_ms_name: SGG_SoaServer3
              wls_ms_port: 8065
            soa-sgg-vm-04.company.internal:
