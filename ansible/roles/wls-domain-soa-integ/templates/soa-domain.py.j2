# SOA INTEG_Domain creation — generated by Ansible (wls-domain-soa-integ role).
# Clusters: INTEG-OSB-CLUSTER, INTEG-SOA-CLUSTER, INTEG-WSM-CLUSTER
# Credentials consumed from environment variables — never hardcoded.

import os
import sys

domain_name  = '{{ soa_domain_name }}'
domain_home  = '{{ soa_domain_home }}'
admin_port   = {{ soa_admin_port }}
osb_port     = {{ soa_osb_port }}
soa_port     = {{ soa_ms_port }}
wsm_port     = {{ soa_wsm_port }}
mw_home      = '{{ mw_home }}'
soa_home     = '{{ soa_home }}'

# ------------------------------------------------------------------
# Read base + SOA + OSB + WSM-PM extension templates
# ------------------------------------------------------------------
readTemplate(mw_home + '/wlserver/common/templates/wls/wls.jar')
addTemplate(soa_home + '/soa/common/templates/wls/oracle.soa.sys.domain_template.jar')
addTemplate(soa_home + '/osb/common/templates/wls/oracle.osb.domain_template.jar')
addTemplate(soa_home + '/oracle_common/common/templates/wls/oracle.wsmpm.domain_template.jar')

set('Name', domain_name)
setOption('DomainName', domain_name)

cd('Servers/AdminServer')
set('ListenPort', admin_port)

# Bootstrap admin credential — injected via WLS_ADMIN_PASSWORD env var at runtime.
# Rotated by BeyondTrust post-install. Never stored as a string literal.
wls_admin_password = os.environ.get('WLS_ADMIN_PASSWORD')
if not wls_admin_password:
    print('ERROR: WLS_ADMIN_PASSWORD environment variable is not set.')
    sys.exit(1)

cd('/Security/' + domain_name + '/User/weblogic')
cmo.setPassword(wls_admin_password)

# ------------------------------------------------------------------
# OSB cluster and Managed Servers
# ------------------------------------------------------------------
cd('/')
create('INTEG-OSB-CLUSTER', 'Cluster')
cd('Clusters/INTEG-OSB-CLUSTER')
set('ClusterMessagingMode', 'unicast')

{% for host in groups[soa_osb_group] %}
cd('/')
create('{{ host }}', 'Machine')
cd('Machines/{{ host }}/NodeManager')
set('ListenAddress', '{{ hostvars[host]["ansible_host"] | default(host) }}')
set('ListenPort', {{ nm_port }})
set('NMType', '{{ nm_type }}')

cd('/')
create('{{ hostvars[host]["wls_ms_name"] }}', 'Server')
cd('Servers/{{ hostvars[host]["wls_ms_name"] }}')
set('ListenAddress', '{{ hostvars[host]["ansible_host"] | default(host) }}')
set('ListenPort', osb_port)
set('Cluster', 'INTEG-OSB-CLUSTER')
set('Machine', '{{ host }}')
{% endfor %}

# ------------------------------------------------------------------
# SOA cluster and Managed Servers
# ------------------------------------------------------------------
cd('/')
create('INTEG-SOA-CLUSTER', 'Cluster')
cd('Clusters/INTEG-SOA-CLUSTER')
set('ClusterMessagingMode', 'unicast')

{% for host in groups[soa_ms_group] %}
cd('/')
create('{{ host }}', 'Machine')
cd('Machines/{{ host }}/NodeManager')
set('ListenAddress', '{{ hostvars[host]["ansible_host"] | default(host) }}')
set('ListenPort', {{ nm_port }})
set('NMType', '{{ nm_type }}')

cd('/')
create('{{ hostvars[host]["wls_ms_name"] }}', 'Server')
cd('Servers/{{ hostvars[host]["wls_ms_name"] }}')
set('ListenAddress', '{{ hostvars[host]["ansible_host"] | default(host) }}')
set('ListenPort', soa_port)
set('Cluster', 'INTEG-SOA-CLUSTER')
set('Machine', '{{ host }}')
{% endfor %}

# ------------------------------------------------------------------
# WSM-PM cluster
# ------------------------------------------------------------------
cd('/')
create('INTEG-WSM-CLUSTER', 'Cluster')
cd('Clusters/INTEG-WSM-CLUSTER')
set('ClusterMessagingMode', 'unicast')

{% for host in groups[soa_wsm_group] %}
cd('/')
create('{{ host }}', 'Machine')
cd('Machines/{{ host }}/NodeManager')
set('ListenAddress', '{{ hostvars[host]["ansible_host"] | default(host) }}')
set('ListenPort', {{ nm_port }})
set('NMType', '{{ nm_type }}')

cd('/')
create('{{ hostvars[host]["wls_ms_name"] }}', 'Server')
cd('Servers/{{ hostvars[host]["wls_ms_name"] }}')
set('ListenAddress', '{{ hostvars[host]["ansible_host"] | default(host) }}')
set('ListenPort', wsm_port)
set('Cluster', 'INTEG-WSM-CLUSTER')
set('Machine', '{{ host }}')
{% endfor %}

# ------------------------------------------------------------------
# JDBC data sources for SOA Infra
# ------------------------------------------------------------------
soa_ds_url = 'jdbc:oracle:thin:@//{{ soa_db_scan }}:{{ rac_listener_port }}/{{ soa_db_service }}'

for ds_name in ['SOADataSource', 'SOALocalTxDataSource']:
    cd('/JDBCSystemResources/' + ds_name + '/JDBCResource/' + ds_name + '/JDBCDriverParams/' + ds_name)
    set('Url', soa_ds_url)
    cd('/JDBCSystemResources/' + ds_name + '/JDBCResource/' + ds_name + '/JDBCDriverParams/' + ds_name + '/Properties/' + ds_name + '/Property/user')
    set('Value', '{{ soa_db_user }}')

# ------------------------------------------------------------------
# Write domain
# ------------------------------------------------------------------
writeDomain(domain_home)
closeTemplate()
print('SOA INTEG domain created: ' + domain_home)
exit()
