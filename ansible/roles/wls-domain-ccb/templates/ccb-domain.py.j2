# CCB WLS domain creation — generated by Ansible (wls-domain-ccb role).
# Runs WLST offline. Do not edit manually; re-run Ansible to regenerate.
# Credentials consumed from environment variables — never hardcoded.

import os
import sys

domain_name  = '{{ ccb_domain_name }}'
domain_home  = '{{ ccb_domain_home }}'
admin_port   = {{ ccb_admin_port }}
wls_template = '{{ wls_home }}/wlserver/common/templates/wls/wls.jar'

# ------------------------------------------------------------------
# Read domain template and configure Admin Server
# ------------------------------------------------------------------
readTemplate(wls_template)

set('Name', domain_name)
setOption('DomainName', domain_name)

cd('Servers/AdminServer')
set('ListenPort', admin_port)
set('Name', 'AdminServer')

# Bootstrap admin credential — injected via WLS_ADMIN_PASSWORD env var at runtime.
# Rotated by BeyondTrust post-install. Never stored as a string literal.
wls_admin_password = os.environ.get('WLS_ADMIN_PASSWORD')
if not wls_admin_password:
    print('ERROR: WLS_ADMIN_PASSWORD environment variable is not set.')
    sys.exit(1)

cd('/Security/' + domain_name + '/User/weblogic')
cmo.setPassword(wls_admin_password)

# ------------------------------------------------------------------
# Clusters
# ------------------------------------------------------------------
cd('/')
create('CCB-WEB', 'Cluster')
cd('Clusters/CCB-WEB')
set('ClusterMessagingMode', 'unicast')

cd('/')
create('CCB-IWS', 'Cluster')
cd('Clusters/CCB-IWS')
set('ClusterMessagingMode', 'unicast')

cd('/')
create('CCB-BATCH', 'Cluster')
cd('Clusters/CCB-BATCH')
set('ClusterMessagingMode', 'unicast')

# ------------------------------------------------------------------
# Machines and Managed Servers — one MS per inventory host
# ------------------------------------------------------------------
{% for host in groups['ccb_web'] %}
cd('/')
create('{{ host }}', 'Machine')
cd('Machines/{{ host }}/NodeManager')
set('ListenAddress', '{{ hostvars[host]["ansible_host"] | default(host) }}')
set('ListenPort', {{ nm_port }})
set('NMType', '{{ nm_type }}')

cd('/')
create('{{ host }}-ms', 'Server')
cd('Servers/{{ host }}-ms')
set('ListenAddress', '{{ hostvars[host]["ansible_host"] | default(host) }}')
set('ListenPort', {{ ccb_web_port }})
set('Cluster', 'CCB-WEB')
set('Machine', '{{ host }}')
{% endfor %}

{% for host in groups['ccb_iws'] %}
cd('/')
create('{{ host }}', 'Machine')
cd('Machines/{{ host }}/NodeManager')
set('ListenAddress', '{{ hostvars[host]["ansible_host"] | default(host) }}')
set('ListenPort', {{ nm_port }})
set('NMType', '{{ nm_type }}')

cd('/')
create('{{ host }}-ms', 'Server')
cd('Servers/{{ host }}-ms')
set('ListenAddress', '{{ hostvars[host]["ansible_host"] | default(host) }}')
set('ListenPort', {{ ccb_iws_port }})
set('Cluster', 'CCB-IWS')
set('Machine', '{{ host }}')
{% endfor %}

{% for host in groups['ccb_batch'] %}
cd('/')
create('{{ host }}', 'Machine')
cd('Machines/{{ host }}/NodeManager')
set('ListenAddress', '{{ hostvars[host]["ansible_host"] | default(host) }}')
set('ListenPort', {{ nm_port }})
set('NMType', '{{ nm_type }}')

cd('/')
create('{{ host }}-ms', 'Server')
cd('Servers/{{ host }}-ms')
set('ListenAddress', '{{ hostvars[host]["ansible_host"] | default(host) }}')
set('ListenPort', {{ ccb_batch_port }})
set('Cluster', 'CCB-BATCH')
set('Machine', '{{ host }}')
{% endfor %}

# ------------------------------------------------------------------
# Write domain
# ------------------------------------------------------------------
writeDomain(domain_home)
closeTemplate()
print('CCB domain created at: ' + domain_home)
exit()
