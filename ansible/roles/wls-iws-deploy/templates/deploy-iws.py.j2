# WebServices.ear deployment — generated by Ansible (wls-iws-deploy role).

admin_url  = 't3://{{ admin_host }}:{{ admin_port }}'
admin_user = '{{ admin_user }}'
admin_pass = '{{ admin_password }}'

connect(admin_user, admin_pass, admin_url)

app_name = 'WebServices'
ear_path = '{{ iws_ear_source }}'
target   = '{{ iws_cluster }}'

try:
    app = getMBean('/AppDeployments/' + app_name)
    if app is None:
        print('Deploying ' + app_name + ' to ' + target)
        deploy(app_name, ear_path, targets=target, block='true')
        print('Successfully deployed ' + app_name)
    else:
        print(app_name + ' already deployed — checking for updates')
        redeploy(app_name, ear_path, block='true')
        print('Successfully deployed ' + app_name)
except Exception as e:
    print('Deployment failed: ' + str(e))
    raise

disconnect()
exit()
