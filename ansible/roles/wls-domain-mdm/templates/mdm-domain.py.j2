# MDM WLS domain creation — generated by Ansible (wls-domain-mdm role).
# Runs WLST offline. Do not edit manually; re-run Ansible to regenerate.

domain_name  = '{{ mdm_domain_name }}'
domain_home  = '{{ mdm_domain_home }}'
admin_port   = {{ mdm_admin_port }}
wls_template = '{{ wls_home }}/wlserver/common/templates/wls/wls.jar'

readTemplate(wls_template)

set('Name', domain_name)
setOption('DomainName', domain_name)

cd('Servers/AdminServer')
set('ListenPort', admin_port)
set('Name', 'AdminServer')

cd('/Security/' + domain_name + '/User/weblogic')
cmo.setPassword('{{ vault_wls_admin_password }}')

cd('/')
create('MDM-WEB', 'Cluster')
cd('Clusters/MDM-WEB')
set('ClusterMessagingMode', 'unicast')

cd('/')
create('MDM-IWS', 'Cluster')
cd('Clusters/MDM-IWS')
set('ClusterMessagingMode', 'unicast')

cd('/')
create('MDM-BATCH', 'Cluster')
cd('Clusters/MDM-BATCH')
set('ClusterMessagingMode', 'unicast')

{% for host in groups['mdm_web'] %}
cd('/')
create('{{ host }}', 'Machine')
cd('Machines/{{ host }}/NodeManager')
set('ListenAddress', '{{ hostvars[host]["ansible_host"] | default(host) }}')
set('ListenPort', {{ nm_port }})
set('NMType', '{{ nm_type }}')

cd('/')
create('{{ host }}-ms', 'Server')
cd('Servers/{{ host }}-ms')
set('ListenAddress', '{{ hostvars[host]["ansible_host"] | default(host) }}')
set('ListenPort', {{ mdm_web_port }})
set('Cluster', 'MDM-WEB')
set('Machine', '{{ host }}')
{% endfor %}

{% for host in groups['mdm_iws'] %}
cd('/')
create('{{ host }}', 'Machine')
cd('Machines/{{ host }}/NodeManager')
set('ListenAddress', '{{ hostvars[host]["ansible_host"] | default(host) }}')
set('ListenPort', {{ nm_port }})
set('NMType', '{{ nm_type }}')

cd('/')
create('{{ host }}-ms', 'Server')
cd('Servers/{{ host }}-ms')
set('ListenAddress', '{{ hostvars[host]["ansible_host"] | default(host) }}')
set('ListenPort', {{ mdm_iws_port }})
set('Cluster', 'MDM-IWS')
set('Machine', '{{ host }}')
{% endfor %}

{% for host in groups['mdm_batch'] %}
cd('/')
create('{{ host }}', 'Machine')
cd('Machines/{{ host }}/NodeManager')
set('ListenAddress', '{{ hostvars[host]["ansible_host"] | default(host) }}')
set('ListenPort', {{ nm_port }})
set('NMType', '{{ nm_type }}')

cd('/')
create('{{ host }}-ms', 'Server')
cd('Servers/{{ host }}-ms')
set('ListenAddress', '{{ hostvars[host]["ansible_host"] | default(host) }}')
set('ListenPort', {{ mdm_batch_port }})
set('Cluster', 'MDM-BATCH')
set('Machine', '{{ host }}')
{% endfor %}

writeDomain(domain_home)
closeTemplate()
print('MDM domain created at: ' + domain_home)
exit()
