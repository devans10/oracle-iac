#!/bin/bash
# {{ item.domain_home }}/bin/bt-startup.sh
# Generated by Ansible beyondtrust-integration role — do not edit manually.
#
# Retrieves runtime credentials from BeyondTrust PasswordSafe and injects them
# into the running WLS domain via WLST before Managed Servers accept traffic.
#
# Called by Node Manager startup scripts or systemd service units AFTER the
# WLS Admin Server is confirmed reachable.
#
# Usage: bt-startup.sh
# Dependencies: get-credential.sh, wlst.sh, BT_API_BASE_URL in environment
#               or ~/.bt_wallet/credentials populated by ops.

set -euo pipefail

DOMAIN_HOME="{{ item.domain_home }}"
export ADMIN_URL="{{ item.admin_url }}"
export ADMIN_USER="{{ item.admin_user }}"
BT_SYSTEM="{{ item.system_name }}"
GET_CRED="{{ bt_get_credential }}"
WLST="{{ wls_home }}/oracle_common/common/bin/wlst.sh"
LOG_DIR="{{ oracle_logs }}/bt-startup"
LOG_FILE="${LOG_DIR}/bt-startup-$(date +%Y%m%d-%H%M%S)-$$.log"

# ── Sanity checks ────────────────────────────────────────────────────────────
[[ -x "${GET_CRED}" ]]  || { echo "ERROR: ${GET_CRED} not found or not executable" >&2; exit 1; }
[[ -x "${WLST}" ]]      || { echo "ERROR: ${WLST} not found or not executable" >&2; exit 1; }

mkdir -p "${LOG_DIR}"

echo "[$(date '+%Y-%m-%d %H:%M:%S')] bt-startup: domain=${DOMAIN_HOME} admin_url=${ADMIN_URL}" \
  | tee -a "${LOG_FILE}"

# ── Retrieve WLS admin password ───────────────────────────────────────────────
# The oracle account on this VM is the WLS process owner; its PasswordSafe
# credential doubles as the WLS admin bootstrap password on first startup.
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Retrieving WLS admin credential from BeyondTrust ..." \
  | tee -a "${LOG_FILE}"
export ADMIN_PASSWORD
ADMIN_PASSWORD="$("${GET_CRED}" "${BT_SYSTEM}" oracle)"

# ── Retrieve JDBC datasource password ─────────────────────────────────────────
# The DB schema account used by this domain's JDBC datasources is retrieved
# from the SOA RAC managed system.  Ops must ensure a Managed Account named
# after the schema prefix (e.g. INT_SOAINFRA) exists under system SOA-RAC-01.
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Retrieving DB datasource credential from BeyondTrust ..." \
  | tee -a "${LOG_FILE}"
DB_SCHEMA_ACCOUNT="${BT_SYSTEM}_SCHEMA"
# Override: if the caller exported BT_DB_ACCOUNT, use that directly.
DB_ACCOUNT="${BT_DB_ACCOUNT:-${DB_SCHEMA_ACCOUNT}}"
export DB_PASSWORD
DB_PASSWORD="$("${GET_CRED}" "${BT_SYSTEM}" "${DB_ACCOUNT}")"

# ── Inject credentials via WLST ───────────────────────────────────────────────
# Connects to the running Admin Server, iterates all JDBC datasources in the
# domain, and updates their passwords.  Activates the change immediately.
# Credentials are passed as environment variables — never written to disk.
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Connecting to Admin Server at ${ADMIN_URL} ..." \
  | tee -a "${LOG_FILE}"

"${WLST}" /dev/stdin << 'WLST_SCRIPT' 2>&1 | tee -a "${LOG_FILE}"
import os

admin_url      = os.environ['ADMIN_URL']      if 'ADMIN_URL'      in os.environ else None
admin_user     = os.environ['ADMIN_USER']     if 'ADMIN_USER'     in os.environ else None
admin_password = os.environ['ADMIN_PASSWORD'] if 'ADMIN_PASSWORD' in os.environ else None
db_password    = os.environ['DB_PASSWORD']    if 'DB_PASSWORD'    in os.environ else None

if not all([admin_url, admin_user, admin_password, db_password]):
    print('ERROR: One or more required environment variables are missing.')
    exit(exitcode=1)

print('Connecting to Admin Server: ' + admin_url)
connect(admin_user, admin_password, admin_url)
edit()
startEdit()

try:
    # Iterate all JDBC datasources and update passwords
    ds_config = cmo.getJDBCSystemResources()
    if len(ds_config) == 0:
        print('WARNING: No JDBC datasources found in domain.')
    for ds in ds_config:
        ds_name = ds.getName()
        print('Updating password for datasource: ' + ds_name)
        cd('/JDBCSystemResources/' + ds_name + '/JDBCResource/' + ds_name +
           '/JDBCDriverParams/' + ds_name)
        set('PasswordEncrypted', db_password)
    activate()
    print('All datasource passwords updated and change activated.')
except Exception as e:
    print('ERROR during datasource password update: ' + str(e))
    cancelEdit('y')
    exit(exitcode=1)
finally:
    disconnect()
    exit()
WLST_SCRIPT

WLST_RC=${PIPESTATUS[0]}
if [[ "${WLST_RC}" -ne 0 ]]; then
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] ERROR: WLST credential injection failed (exit ${WLST_RC})" \
    | tee -a "${LOG_FILE}"
  exit "${WLST_RC}"
fi

echo "[$(date '+%Y-%m-%d %H:%M:%S')] bt-startup complete." | tee -a "${LOG_FILE}"
