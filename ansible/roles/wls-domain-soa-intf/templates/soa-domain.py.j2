# SOA INTF_Domain creation — generated by Ansible (wls-domain-soa-intf role).
# Clusters: INTF-OSB-CLUSTER, INTF-SOA-CLUSTER, INTF-BAM-CLUSTER, INTF-ODI-CLUSTER, INTF-WSM-CLUSTER
# Credentials consumed from environment variables — never hardcoded.

import os
import sys

domain_name  = '{{ soa_domain_name }}'
domain_home  = '{{ soa_domain_home }}'
admin_port   = {{ soa_admin_port }}
osb_port     = {{ soa_osb_port }}
soa_port     = {{ soa_ms_port }}
bam_port     = {{ soa_bam_port }}
odi_port     = {{ soa_odi_port }}
wsm_port     = {{ soa_wsm_port }}
mw_home      = '{{ mw_home }}'
soa_home     = '{{ soa_home }}'

# ------------------------------------------------------------------
# Read base + SOA + OSB + BAM + ODI + WSM-PM extension templates
# ------------------------------------------------------------------
readTemplate(mw_home + '/wlserver/common/templates/wls/wls.jar')
addTemplate(soa_home + '/soa/common/templates/wls/oracle.soa.sys.domain_template.jar')
addTemplate(soa_home + '/osb/common/templates/wls/oracle.osb.domain_template.jar')
addTemplate(soa_home + '/soa/common/templates/wls/oracle.bam.domain_template.jar')
addTemplate(soa_home + '/odi/common/templates/wls/oracle.odi.domain_template.jar')
addTemplate(soa_home + '/oracle_common/common/templates/wls/oracle.wsmpm.domain_template.jar')

set('Name', domain_name)
setOption('DomainName', domain_name)

cd('Servers/AdminServer')
set('ListenPort', admin_port)

# Bootstrap admin credential — injected via WLS_ADMIN_PASSWORD env var at runtime.
# Rotated by BeyondTrust post-install. Never stored as a string literal.
wls_admin_password = os.environ.get('WLS_ADMIN_PASSWORD')
if not wls_admin_password:
    print('ERROR: WLS_ADMIN_PASSWORD environment variable is not set.')
    sys.exit(1)

cd('/Security/' + domain_name + '/User/weblogic')
cmo.setPassword(wls_admin_password)

# ------------------------------------------------------------------
# OSB cluster and Managed Servers
# ------------------------------------------------------------------
cd('/')
create('INTF-OSB-CLUSTER', 'Cluster')
cd('Clusters/INTF-OSB-CLUSTER')
set('ClusterMessagingMode', 'unicast')

{% for host in groups[soa_osb_group] %}
cd('/')
create('{{ host }}', 'Machine')
cd('Machines/{{ host }}/NodeManager')
set('ListenAddress', '{{ hostvars[host]["ansible_host"] | default(host) }}')
set('ListenPort', {{ nm_port }})
set('NMType', '{{ nm_type }}')

cd('/')
create('{{ hostvars[host]["wls_ms_name"] }}', 'Server')
cd('Servers/{{ hostvars[host]["wls_ms_name"] }}')
set('ListenAddress', '{{ hostvars[host]["ansible_host"] | default(host) }}')
set('ListenPort', osb_port)
set('Cluster', 'INTF-OSB-CLUSTER')
set('Machine', '{{ host }}')
{% endfor %}

