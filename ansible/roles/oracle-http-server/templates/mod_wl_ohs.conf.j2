# mod_wl_ohs.conf — managed by Ansible (oracle-http-server role). Do not edit manually.
# Proxies web-tier requests to WLS clusters. Batch clusters are NOT proxied (ADR-002).

LoadModule weblogic_module ${ORACLE_HOME}/ohs/modules/mod_wl_ohs.so

<IfModule mod_weblogic.c>
  WebLogicHost {{ groups['ccb_web'][0] }}
  WebLogicPort {{ ccb_web_port | default(7002) }}
  ConnectTimeoutSecs 10
  ConnectRetrySecs 2
  Idempotent OFF
</IfModule>

# CC&B web cluster
<Location /ccb>
  SetHandler weblogic-handler
  WebLogicCluster {% for host in groups['ccb_web'] %}{{ hostvars[host]['ansible_host'] | default(host) }}:{{ hostvars[host]['wls_ms_port'] | default(7002) }}{% if not loop.last %},{% endif %}{% endfor %}

  WLCookieName OUAF_JSESSIONID
</Location>

# CC&B IWS cluster
<Location /ccb-iws>
  SetHandler weblogic-handler
  WebLogicCluster {% for host in groups['ccb_iws'] %}{{ hostvars[host]['ansible_host'] | default(host) }}:{{ hostvars[host]['wls_ms_port'] | default(7004) }}{% if not loop.last %},{% endif %}{% endfor %}

</Location>

