# mod_wl_ohs.conf — managed by Ansible (oracle-http-server role). Do not edit manually.
# Proxies web-tier requests to WLS clusters. Batch clusters are NOT proxied (ADR-002).

LoadModule weblogic_module ${ORACLE_HOME}/ohs/modules/mod_wl_ohs.so

<IfModule mod_weblogic.c>
  WebLogicHost {{ groups['ccb_web'][0] }}
  WebLogicPort {{ ccb_web_port | default(7010) }}
  ConnectTimeoutSecs 10
  ConnectRetrySecs 2
  Idempotent OFF
</IfModule>

# CC&B web cluster
<Location /ouaf>
  SetHandler weblogic-handler
  WebLogicCluster {% for host in groups['ccb_web'] %}{{ hostvars[host]['ansible_host'] | default(host) }}:{{ ccb_web_port | default(7010) }}{% if not loop.last %},{% endif %}{% endfor %}

  WLCookieName OUAF_JSESSIONID
  PathTrim /ouaf
  PathPrepend /ouaf
</Location>

# MDM web cluster
<Location /mdm>
  SetHandler weblogic-handler
  WebLogicCluster {% for host in groups['mdm_web'] %}{{ hostvars[host]['ansible_host'] | default(host) }}:{{ mdm_web_port | default(8010) }}{% if not loop.last %},{% endif %}{% endfor %}

  WLCookieName MDM_JSESSIONID
  PathTrim /mdm
  PathPrepend /mdm
</Location>

# SOA soa_web domain composite HTTP bindings
<Location /soa-infra>
  SetHandler weblogic-handler
  WebLogicCluster {% for host in groups['soa_web_ms'] %}{{ hostvars[host]['ansible_host'] | default(host) }}:{{ soa_web_ms_port | default(8302) }}{% if not loop.last %},{% endif %}{% endfor %}

</Location>
